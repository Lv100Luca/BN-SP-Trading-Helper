# /etc/systemd/system/tradecheck-table.service
[Unit]
Description=Trade Check global lookup table
After=network.target

[Service]
User=tradecheck
WorkingDirectory=/opt/tradecheck
EnvironmentFile=/opt/tradecheck/env
ExecStart=/usr/bin/python3 /opt/tradecheck/tradecheck_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tradecheck
PrivateTmp=true

[Install]
WantedBy=multi-user.target
